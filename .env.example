# ==============================================================================
# MarkAI Environment Variables
# Copy this file to .env.local and populate with your API credentials
# ==============================================================================

# 1. Anthropic API (Claude) - Server-side only
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# 2. Firebase Auth (Client-side)
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id

# 3. Supabase Database (Postgres)
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# 4. Meta Graph API (Instagram Business) - Server-side only
# Get your Long-lived Page/User Access Token with pages_show_list, instagram_basic, instagram_content_publish
META_ACCESS_TOKEN=your_meta_system_user_or_page_access_token
INSTAGRAM_ACCOUNT_ID=your_instagram_business_account_id
